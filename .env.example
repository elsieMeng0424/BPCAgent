# Copy this file to .env and fill in your model provider's settings.
# Existing environment variables take precedence over this file.
LLM_API_KEY=sk-68fbd8e877774fcf9ace6d76b2297d15
LLM_MODEL_ID=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
